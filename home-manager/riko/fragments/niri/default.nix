{
  config,
  inputs,
  lib,
  pkgs,
  customUtils,
  ...
}:
let
  system = pkgs.stdenv.hostPlatform.system;
  niriPkg = inputs.niri-main.packages.${system}.default;
  scratchpadPath = ./scratchpad.kdl;
  scratchpadSymlink = config.lib.file.mkOutOfStoreSymlink (
    customUtils.getRealAbsolutePath scratchpadPath
  );
in
{
  imports = [ ./config.d.nix ];

  wayland.windowManager.niri = {
    enable = true;
    package = niriPkg;
    checkConfig = false;
  };

  # checkPhase runs sandboxed and can't read the out-of-store symlink
  # so validate against a real store path instead
  home.extraDependencies = [
    (pkgs.writeTextFile {
      name = "niri-tmp-config.kdl";
      text = ''
        ${config.wayland.windowManager.niri.extraConfig}
        include "${scratchpadPath}"
      '';
      checkPhase = ''
        ${lib.getExe niriPkg} validate --config "$target"
      '';
    })
  ];

  xdg.configFile."niri/config.kdl" = lib.mkOverride 10 {
    source = pkgs.writeTextFile {
      name = "niri-config.kdl";
      text = ''
        // Automatically generated by home-manager from `wayland.windowManager.niri`
        ${config.wayland.windowManager.niri.extraConfig}
        include "${scratchpadSymlink}"
      '';
    };
  };

  home.packages = with pkgs; [
    fuzzel
    waybar
    wl-mirror
    wlr-randr
  ];

  system.services.displayManager = {
    defaultSession = "niri";
    sessionPackages = [ niriPkg ];
  };
}
