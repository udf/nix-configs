binds {
  Mod+Up { focus-window-up; }
  Mod+Down { focus-window-down; }
  Mod+Left { focus-column-left; }
  Mod+Right { focus-column-right; }

  Mod+Shift+Up    { move-window-up; }
  Mod+Shift+Down  { move-window-down; }
  Mod+Shift+Left  { move-column-left; }
  Mod+Shift+Right { move-column-right; }

  // Mod+Alt - Workspace related bindings
  Mod+Alt+Up { focus-workspace-up; }
  Mod+Alt+Down { focus-workspace-down; }
  Mod+Alt+Left  { focus-column-first; }
  Mod+Alt+Right { focus-column-last; }

  Mod+Alt+Shift+Up   { move-column-to-workspace-up; }
  Mod+Alt+Shift+Down { move-column-to-workspace-down; }
  Mod+Alt+Shift+Left { move-column-to-first; }
  Mod+Alt+Shift+Right  { move-column-to-last; }

  Mod+Alt+Shift+Page_Up { move-workspace-down; }
  Mod+Alt+Shift+Page_Down   { move-workspace-up; }

  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; }

  // Mod+Ctrl - Monitor related bindings
  Mod+Ctrl+Alt+Up    { focus-monitor-up; }
  Mod+Ctrl+Alt+Down  { focus-monitor-down; }
  Mod+Ctrl+Alt+Left  { focus-monitor-left; }
  Mod+Ctrl+Alt+Right { focus-monitor-right; }

  Mod+Ctrl+Alt+Shift+Up    { move-column-to-monitor-up; }
  Mod+Ctrl+Alt+Shift+Down  { move-column-to-monitor-down; }
  Mod+Ctrl+Alt+Shift+Left  { move-column-to-monitor-left; }
  Mod+Ctrl+Alt+Shift+Right { move-column-to-monitor-right; }

  Mod+Grave { focus-monitor-next; }
  Mod+Shift+Grave { move-column-to-monitor-next; }
  Mod+Ctrl+Shift+Grave { move-workspace-to-monitor-next; }

  Mod+Ctrl+Shift+Up    { move-workspace-to-monitor-up; }
  Mod+Ctrl+Shift+Down  { move-workspace-to-monitor-down; }
  Mod+Ctrl+Shift+Left  { move-workspace-to-monitor-left; }
  Mod+Ctrl+Shift+Right { move-workspace-to-monitor-right; }

  // Columns
  Mod+I  { consume-window-into-column; }
  Mod+O { expel-window-from-column; }
  Mod+Shift+I  { consume-or-expel-window-left; }
  Mod+Shift+O { consume-or-expel-window-right; }

  Mod+V { center-column; }
  Mod+Shift+V { center-visible-columns; }

  // Tabs
  Mod+W { toggle-column-tabbed-display; }

  // Floating windows
  Mod+Space       { toggle-window-floating; }
  Mod+Shift+Space { switch-focus-between-floating-and-tiling; }
}
