output "eDP-1" {
  position x=640 y=1440
  mode "1920x1080@120.030"
  scale 1
  transform "normal"
  variable-refresh-rate
}

output "Dell Inc. DELL S2721DGF CZ7Q023" {
  position x=0 y=0
  mode "2560x1440@59.951"
  scale 1
  variable-refresh-rate
  max-bpc 8
}

