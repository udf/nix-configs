recent-windows {
  debounce-ms 750
  open-delay-ms 150

  highlight {
    active-color "#999999ff"
    urgent-color "#ff9999ff"
    padding 5
    corner-radius 0
  }

  previews {
    max-height 480
    max-scale 0.5
  }

  binds {
    Alt+Tab { next-window scope="output"; }
    Alt+Shift+Tab { previous-window scope="output"; }

    Mod+Tab { next-window scope="all"; }
    Mod+Shift+Tab { previous-window scope="all"; }
  }
}
