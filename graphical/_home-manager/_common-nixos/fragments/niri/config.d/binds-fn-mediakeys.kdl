binds {
  // Audio Volume Controls
  XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01+" "-l" "1.0"; }
  XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01-"; }
  XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

  Mod+Alt+D { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01+" "-l" "1.0"; }
  Mod+Alt+C { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.01-"; }
  Mod+Alt+E { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

  // Media controls
  XF86AudioPlay { spawn "playerctl" "-p" "playerctld" "play-pause"; }
  XF86AudioNext { spawn "playerctl" "-p" "playerctld" "next"; }
  XF86AudioPrev { spawn "playerctl" "-p" "playerctld" "previous"; }
  Mod+Alt+S { spawn "playerctl" "-p" "playerctld" "play-pause"; }
  Mod+Alt+X { spawn "playerctl" "-p" "playerctld" "next"; }
  Mod+Alt+Z { spawn "playerctl" "-p" "playerctld" "previous"; }

  Mod+Ctrl+XF86AudioRaiseVolume { spawn "playerctl" "-p" "playerctld" "volume" "0.01+"; }
  Mod+Ctrl+XF86AudioLowerVolume { spawn "playerctl" "-p" "playerctld" "volume" "0.01-"; }
  Mod+Alt+F { spawn "playerctl" "-p" "playerctld" "volume" "0.01+"; }
  Mod+Alt+V { spawn "playerctl" "-p" "playerctld" "volume" "0.01-"; }

  Mod+XF86AudioNext repeat=false { spawn "playerctld" "shift"; }
  Mod+XF86AudioPrev repeat=false { spawn "playerctld" "unshift"; }
  Mod+Alt+W repeat=false { spawn "playerctld" "shift"; }
  Mod+Alt+Q repeat=false { spawn "playerctld" "unshift"; }

  Mod+XF86AudioRaiseVolume { spawn "playerctl" "-p" "playerctld" "position" "2+"; }
  Mod+XF86AudioLowerVolume { spawn "playerctl" "-p" "playerctld" "position" "2-"; }
  Mod+Alt+TouchpadScrollLeft  { spawn "playerctl" "-p" "playerctld" "position" "2+"; }
  Mod+Alt+TouchpadScrollRight { spawn "playerctl" "-p" "playerctld" "position" "2-"; }

  // Brightness controls
  XF86MonBrightnessUp { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
  XF86MonBrightnessDown { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
}
